<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.dataadmin.mapper.CalibRecordMapper">

    <!-- 公共查询字段。 -->
    <sql id="columns">
        id, channel_id, channel_name, outlier_count,
        is_deleted, create_time, update_time
    </sql>

    <!-- 同一次查询汇总累计校准及野值数量，无记录时统一返回零。 -->
    <select id="findOverview"
            resultType="com.example.dataadmin.vo.calibration.CalibrationOverviewVO">
        select coalesce(sum(calibration_count), 0) as calibration_count,
               coalesce(sum(outlier_count), 0) as outlier_count
        from calib_record
        where is_deleted = 0
        <!-- 全局配置及查询不按试验任务隔离，保留主键与业务范围约束。 -->
        <!-- 全局配置及查询不按试验任务隔离，保留主键与业务范围约束。 -->
    </select>

    <!-- 列表复用原有汇总字段，额外读取每个通道的累计校准数量。 -->
    <select id="findAllByTaskId"
            resultType="com.example.dataadmin.vo.calibration.CalibRecordListVO">
        select <include refid="columns"/>, calibration_count
        from calib_record
        <where>
            <!-- 全局配置及查询不按试验任务隔离，保留主键与业务范围约束。 -->
            <!-- 全局配置及查询不按试验任务隔离，保留主键与业务范围约束。 -->
            is_deleted = 0
        </where>
        order by id desc
    </select>

    <!-- 按主键查询详情。 -->
    <select id="findByIdAndTaskId" resultType="com.example.dataadmin.entity.CalibRecord">
        select <include refid="columns"/>
        from calib_record
        where id = #{id}

          and is_deleted = 0
    </select>

    <!-- 新增记录并通过序列生成主键。 -->
    <insert id="insert">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            select nextval('calib_record_id_seq')
        </selectKey>
        insert into calib_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            id,
            <!-- 全局配置及查询不按试验任务隔离，保留主键与业务范围约束。 -->
            <if test="channelId != null">channel_id,</if>
            <if test="channelName != null">channel_name,</if>
            <if test="outlierCount != null">outlier_count,</if>
            <if test="isDeleted != null">is_deleted,</if>
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            #{id},
            <!-- 全局配置及查询不按试验任务隔离，保留主键与业务范围约束。 -->
            <if test="channelId != null">#{channelId},</if>
            <if test="channelName != null">#{channelName},</if>
            <if test="outlierCount != null">#{outlierCount},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
        </trim>
    </insert>

    <!-- 校准通道改名时同步更新唯一汇总记录。 -->
    <update id="updateSummaryByChannelId">
        update calib_record
        set channel_name = #{channelName},
            update_time = current_timestamp
        where channel_id = #{channelId}
          and is_deleted = 0
    </update>

    <!-- 删除校准通道时同步逻辑删除唯一汇总记录。 -->
    <update id="deleteByChannelId">
        update calib_record
        set is_deleted = 1,
            update_time = current_timestamp
        where channel_id = #{channelId}
          and is_deleted = 0
    </update>

</mapper>
